NODE_ENV=development
PORT=5000

# ─── PostgreSQL Connection ────────────────────────────────────────────────────
# Paste your Neon.tech / Supabase connection string here.
# Example: postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/chatter?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/chatter

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Change this to a long, random string before deploying.
JWT_SECRET=change_this_to_a_long_random_secret_string

# ─── Client URL (for CORS) ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
